# ============================================================
# AI StudyMate - repository root .gitignore
# Applies to the whole monorepo (backend + frontend).
# ============================================================

# --- Secrets / environment ---
.env
.env.*
!.env.example
*.local

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# --- Node / frontend ---
node_modules/
frontend/dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
