# ============================================================
# AI StudyMate - Backend environment variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#   Windows PowerShell:  Copy-Item .env.example .env
# NEVER commit the real ".env" file to Git.
# ============================================================

# --- Google Gemini API settings ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for all AI features.
# Default is fast and reliable. Other verified options:
#   gemini-flash-latest   (highest quality, may be busy during demand spikes)
#   gemini-3.6-flash      (higher quality, slightly slower)
GEMINI_MODEL=gemini-flash-lite-latest

# Timeout (seconds) for a single AI request, and transient-error retries.
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# --- Application settings ---
APP_NAME=AI StudyMate API
APP_ENV=development

# Comma-separated list of allowed frontend origins (CORS).
# Default Vite dev server runs on port 5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
