# Frontend environment variables (example).
# Copy this file to ".env" and adjust values if needed.
#   PowerShell:  Copy-Item .env.example .env
#
# IMPORTANT: never put a Gemini API key here or anywhere in the frontend.
# The key lives only in backend/.env and is never sent to the browser.

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000